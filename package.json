{
  "name": "evolution-computer-use-win",
  "version": "0.4.2",
  "description": "Self-evolving computer use for DeepSeek Harness: its own browser, the user's Windows desktop with a thought/step overlay, and a library of learned procedures it replays and repairs. Merges evolution-computer-use with dsh-computer-use-win. MCP server and JS library.",
  "license": "MIT",
  "mcpName": "io.github.thefreedoomdoor/evolution-computer-use-win",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefreedoomdoor/evolution-computer-use-win.git"
  },
  "homepage": "https://github.com/thefreedoomdoor/evolution-computer-use-win#readme",
  "bugs": "https://github.com/thefreedoomdoor/evolution-computer-use-win/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./plugin/icon.svg",
  "bin": {
    "evolution-computer-use-win": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./plugin/lib/client.js",
    "./plugin": "./plugin/lib/index.js",
    "./plugin/icon": "./plugin/icon.svg",
    "./plugin/locale/*.json": "./plugin/locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./plugin/icon.svg",
    "./locale/*.json": "./plugin/locale/*.json"
  },
  "files": [
    "lib",
    "scripts",
    "plugin",
    "src/desktop/win32.ps1",
    "README.md",
    "README.zh-CN.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "keywords": [
    "mcp",
    "computer-use",
    "agent",
    "browser",
    "cdp",
    "windows",
    "automation"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.2 || >=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.1"
  }
}
