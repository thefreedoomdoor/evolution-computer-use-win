{
  "name": "evolution-computer-use",
  "version": "0.2.2",
  "description": "Self-evolving computer use for any agent: its own browser, the user's Windows desktop, and a library of learned procedures it replays and repairs. MCP server and JS library.",
  "license": "MIT",
  "mcpName": "io.github.chenkezhen480/evolution-computer-use",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenkezhen480/evolution-computer-use.git"
  },
  "homepage": "https://github.com/chenkezhen480/evolution-computer-use#readme",
  "bugs": "https://github.com/chenkezhen480/evolution-computer-use/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "evolution-computer-use": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/desktop/win32.ps1",
    "README.md",
    "README.zh-CN.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "computer-use",
    "agent",
    "browser",
    "cdp",
    "windows",
    "automation"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3",
    "ws": "^8.18.0"
  }
}
